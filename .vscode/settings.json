{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".deploy_git": true,
        ".github": true,
        "public": true,
        "themes": true,
        "_config.landscape.yml": true,
        ".gitignore": true,
        "package-lock.json": true,
        "db.json": true,
        "node_modules": true
    },
    "hide-files.files": [],
    "markdown.styles": [
        "./source/css/index.css"
    ],
    "markdown.copyFiles.destination": {
        "**/*.md": "${documentDirName}/../imgs/${documentBaseName}/img-${unixTime}.png"
    }
}